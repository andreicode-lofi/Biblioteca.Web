<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Litmap</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap-slate.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Biblioteca.Web.styles.css" asp-append-version="true" />
</head>

<body>

    @{
        var usuarioId = Context.Session.GetString("UsuarioId");
    }

    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-black border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand text-white" asp-area="" asp-controller="Livro" asp-action="Index">Litmap</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                    aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Livro"
                                asp-action="Index">Catálogo Livros</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Livro" asp-action="Create">Criar
                                Livro</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-white bg-success rounded px-3" href="#" data-bs-toggle="modal" data-bs-target="#modalDoacao">
                                Ajude o Litmap 💖
                            </a>
                        </li>
                        
                    </ul>
                    <ul class="navbar-nav">
                        <!-- Dropdown do usuário -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-white" href="#" id="navbarDropdown" role="button"
                                data-bs-toggle="dropdown" aria-expanded="false">
                                Opções
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">

                                <li>
                                    <a class="dropdown-item" asp-area="" asp-controller="Livro" asp-action="MeusFavoritos" asp-route-usuarioId="@usuarioId" target="_blank"> Compartilhar Meus Livros favoritos</a>
                                </li>

                                <li>
                                    <form asp-area="" asp-controller="UsuarioLogin" asp-action="ExcluirUsuario" method="post" onsubmit="return confirmarExclusaoUsuario();">
                                        <button type="submit" class="dropdown-item text-danger" style="background: none; border: none; padding: 0; margin: 0;">
                                            Excluir minha conta
                                        </button>
                                    </form>
                                </li>

                            </ul>
                        </li>
                        <!-- Botão de Logout -->
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="UsuarioLogin"
                                asp-action="Sair">Sair</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted bg-black">
        <div class="container text-center">
            <p class="text-white m-0">Litmap.</p>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        function confirmarExclusaoUsuario() {
            return confirm("Tem certeza de que deseja excluir sua conta? Esta ação é irreversível e todos os seus dados serão apagados.");
        }
    </script>

    <!--modal-->
    @await Html.PartialAsync("_ModalDoacao")

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
