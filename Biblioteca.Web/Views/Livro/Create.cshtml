@model Biblioteca.Web.Models.LivroModel

<div class="container mt-5">
    <h1 class="text-center fw-bold text-primary mb-4">📦 Acabou de Chegar: Novo Livro na Coleção!</h1>

    <form method="post" asp-action="Create" asp-controller="Livro" enctype="multipart/form-data" class="mb-5">
        <div class="row justify-content-center">
            <div class="col-md-10">

                <div class="row g-4">
                    <!-- Coluna Esquerda -->
                    <div class="col-md-6">

                        <!-- Nome do Livro -->
                        <div class="form-group text-start mb-3">
                            <label for="Nome" class="form-label">Nome do Livro.</label>
                            <input type="text" class="form-control form-control-lg" id="Nome" asp-for="Name" placeholder="Digite o nome do livro" required>
                        </div>

                        <!-- Botão de Buscar Livro -->
                        <div class="form-group text-start mb-3">
                            <button type="button" class="btn btn-success mb-2" id="btnBuscarLivro">
                                🔍 Buscar dados do livro pelo nome.
                            </button>
                        </div>

                        <!-- Card para imagem -->
                        <input type="hidden" id="Imagem" name="Imagem" value="@(Model?.Imagem ?? "")" />

                        <div class="card mb-3 p-3" style="border: none; background-color: transparent; max-width: 230px; margin: 0 auto;">
                            <div style="width: 100%; aspect-ratio: 2/3; background-color: #f0f0f0; border-radius: 8px; overflow: hidden; display: flex; justify-content: center; align-items: center;">
                                <img id="imagePreview"
                                     class="shadow"
                                     style="width: 100%; height: 100%; object-fit: cover; object-position: center;" />
                            </div>

                            <div class="mt-3" style="width: 100%;">
                                <label for="Imagem" class="form-label">Imagem do Livro</label>
                                <input type="file"
                                       class="form-control form-control-lg"
                                       id="imageInput"
                                       name="foto"
                                       onchange="previewImage(event)"
                                       accept="image/png, image/jpeg"
                                       style="width: 100%;" />
                                @if (ViewBag.ErroImagem != null)
                                {
                                    <span class="text-danger">@ViewBag.ErroImagem</span>
                                }
                            </div>
                        </div>

                        <!-- Autor -->
                        <div class="form-group text-start mb-3">
                            <label for="Autor" class="form-label">Autor.</label>
                            <input type="text" class="form-control form-control-md" id="Autor" asp-for="Autor" placeholder="Digite o nome do autor" required>
                        </div>

                        <!-- Gênero -->
                        <div class="form-group text-start mb-3">
                            <label for="Genero" class="form-label">Gênero.</label>
                            <input type="text" class="form-control form-control-md" id="Genero" asp-for="Genero" placeholder="Digite o gênero do livro" required>
                        </div>

                        <!-- Ano -->
                        <div class="form-group text-start mb-3">
                            <label for="ano" class="form-label">Ano de Publicação.</label>
                            <input type="number" class="form-control form-control-sm" id="ano" asp-for="ano" placeholder="Digite o ano de publicação" required>
                        </div>
                    </div>

                    <!-- Coluna Direita -->
                    <div class="col-md-6">

                        <!-- Sinopse -->
                        <div class="form-group text-start mb-3">
                            <label for="Sinopse" class="form-label">Sinopse.</label>
                            <textarea class="form-control form-control-lg" id="Sinopse" asp-for="Sinopese" placeholder="Escreva um resumo do livro"></textarea>
                        </div>

                        <!-- Número de Páginas -->
                        <div class="form-group text-start mb-3">
                            <label for="NumeroPaginas" class="form-label">Número de Páginas.</label>
                            <input type="text" class="form-control form-control-sm" id="NumeroPaginas" asp-for="NumeroPaginas" placeholder="Digite o número de páginas">
                        </div>

                        <!-- Comentários -->
                        <div class="form-group text-start mb-3">
                            <label for="Comentarios" class="form-label">Escreva um comentário sobre o livro.</label>
                            <textarea class="form-control form-control-md" id="Comentarios" asp-for="Comentarios" placeholder="Adicione comentários sobre o livro"></textarea>
                        </div>

                        <!-- Avaliação -->
                        <div class="form-group text-start mb-3">
                            <label for="Avaliacao" class="form-label">Avaliação.</label>
                            <select class="form-control form-control-md" id="Avaliacao" asp-for="Avaliacao">
                                <option value="">Selecione uma nota</option>
                                <option value="1">⭐</option>
                                <option value="2">⭐⭐</option>
                                <option value="3">⭐⭐⭐</option>
                                <option value="4">⭐⭐⭐⭐</option>
                                <option value="5">⭐⭐⭐⭐⭐</option>
                            </select>
                        </div>

                        <!-- Livro Finalizado -->
                        <div class="form-check mb-4">
                            <input type="checkbox" class="form-check-input" id="LivroFinalizado" asp-for="LivroFinalizado">
                            <label class="form-check-label" for="LivroFinalizado">Livro Finalizado</label>
                        </div>

                        <!-- Favoritos -->
                        <div class="form-check mb-4">
                            <input type="checkbox" class="form-check-input" id="Favorito" asp-for="Favorito">
                            <label class="form-check-label" for="Favorito">Marcar como favorito</label>
                        </div>

                        <!-- Trechos Favoritos -->
                        <div class="form-group text-start mb-3">
                            <label for="TrechosFavoritos" class="form-label">Trechos Favoritos</label>
                            <div id="trechosContainer">
                                <div class="input-group mb-2">
                                    <input type="text" class="form-control" name="TrechosFavoritos[]" placeholder="Adicione um trecho">
                                    <button type="button" class="btn btn-danger" onclick="removerTrecho(this)">X</button>
                                </div>
                            </div>
                            <button type="button" class="btn btn-secondary mt-2" onclick="adicionarTrecho()">Adicionar Outro Trecho</button>
                        </div>

                    </div>
                </div>

                <!-- Botões -->
                <div class="d-flex justify-content-between mt-4">
                    <button type="submit" class="btn btn-primary w-48">Salvar Livro</button>
                    <a asp-controller="Livro" asp-action="Index" class="btn btn-secondary w-48">Voltar</a>
                </div>

            </div>
        </div>
    </form>
</div>

@section Scripts {
 <script src="~/js/livro-create.js"></script>

}
