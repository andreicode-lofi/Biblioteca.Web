@model Biblioteca.Web.Models.LivroModel

@{
    Layout = "_LayoutDeslogado";
    ViewData["Title"] = "Meus Favoritos";
    var usuarioId = Context.Session.GetString("UsuarioId");
}

<div class="container mt-5">
    <h1 class="text-center fw-bold text-primary mb-4">💖 Por que este é um dos meus livros favoritos? Descubra os detalhes.</h1>

    <div class="row justify-content-center">
        <div class="col-md-10">

            <div class="row g-4">

                <!-- Coluna Esquerda -->
                <div class="col-md-6">
                    <!-- Card para imagem -->
                    <div class="card mb-3 p-3" style="border: none; background-color: transparent; max-width: 230px; margin: 0 auto;">
                        @{
                            string imagemSrc = string.IsNullOrEmpty(Model.Imagem)
                            ? ""
                            : (Model.Imagem.StartsWith("http") ? Model.Imagem : Url.Content("~/images/" + Model.Imagem));
                        }

                        <div style="width: 100%; aspect-ratio: 2/3; background-color: #f0f0f0; border-radius: 8px; overflow: hidden; display: flex; justify-content: center; align-items: center;">
                            <img id="imagePreview"
                                 class="shadow"
                                 src="@imagemSrc"
                                 style="width: 100%; height: 100%; object-fit: cover; object-position: center;" />
                        </div>
                    </div>

                    <!-- Sinopse -->
                    <div class="form-group text-start mb-3">
                        <label class="form-label discord-color">Sinopse.</label>
                        <p class="form-control-static">@Model.Sinopese</p>
                    </div>

                    <!-- Idioma -->
                   <!-- <div class="form-group text-start mb-3">
                        <label class="form-label discord-color">Idioma</label>
                        <p class="form-control-static">@Model.Idioma</p>
                    </div>-->

                    <!-- Ano -->
                    <div class="form-group text-start mb-3">
                        <label class="form-label discord-color">Ano de Publicação.</label>
                        <p class="form-control-static">@Model.ano</p>
                    </div>

                    <!-- Livro Finalizado -->
                    <div class="form-check mb-3">
                        <label class="form-check-label discord-color">
                            @if (Model.LivroFinalizado)
                            {
                                <span>Livro Finalizado.</span>
                            }
                            else
                            {
                                <span>Livro Não Finalizado.</span>
                            }
                        </label>
                    </div>
                </div>

                <!-- Coluna Direita -->
                <div class="col-md-6">

                    <!-- Nome do Livro -->
                    <div class="form-group text-start mb-3">
                        <label class="form-label discord-color">Nome do Livro.</label>
                        <p class="form-control-static">@Model.Name</p>
                    </div>

                    <!-- Autor -->
                    <div class="form-group text-start mb-3">
                        <label class="form-label discord-color">Autor.</label>
                        <p class="form-control-static">@Model.Autor</p>
                    </div>

                    <!-- Gênero -->
                    <div class="form-group text-start mb-3">
                        <label class="form-label discord-color">Gênero.</label>
                        <p class="form-control-static">@Model.Genero</p>
                    </div>
                    
                    <!-- Comentários -->
                    <div class="form-group text-start mb-3">
                        <label class="form-label discord-color">Meu Comentário Sobre o Livro @Model.Name</label>
                        <p class="form-control-static">@Model.Comentarios</p>
                    </div>

                    <!-- Avaliação -->
                    <div class="form-group text-start mb-3">
                        <label class="form-label discord-color">Avaliação.</label>
                        <p class="form-control-static">
                            @switch (Model.Avaliacao)
                            {
                                case "1":
                                    <span>⭐</span>
                                    ; break;
                                case "2":

                                    <span>⭐⭐</span>
                                    ; break;
                                case "3":

                                    <span>⭐⭐⭐</span>
                                    ; break;
                                case "4":

                                    <span>⭐⭐⭐⭐</span>
                                    ; break;
                                case "5":

                                    <span>⭐⭐⭐⭐⭐</span>
                                    ; break;
                                default:

                                    <span>Não Avaliado</span>
                                    ; break;
                            }
                        </p>
                    </div>

                    <!-- Número de Páginas -->
                    <div class="form-group text-start mb-3">
                        <label class="form-label discord-color">Número de Páginas.</label>
                        <p class="form-control-static">@Model.NumeroPaginas</p>
                    </div>

                    <!-- Trechos Favoritos -->
                    <div id="trechosFavoritos" class="form-group text-start mb-3">
                        <label class="form-label discord-color">Trechos que Marcaram Minha Leitura.</label>
                        <ul class="list-group">
                            @{
                                var trechos = ViewData["TrechosPaginados"] as X.PagedList.IPagedList<string>;
                            }

                            @if (trechos != null && trechos.Any())
                            {
                                foreach (var trecho in trechos)
                                {
                                    <li class="list-group-item">@trecho</li>
                                }

                                <!-- Paginação -->
                                <nav class="mt-3">
                                    <ul class="pagination justify-content-center">
                                        @for (int i = 1; i <= trechos.PageCount; i++)
                                        {
                                            <li class="page-item @(i == trechos.PageNumber ? "active" : "")">
                                                <a class="page-link" href="@Url.Action("MeusFavoritosDetails", new { id = Model.Id, page = i })#trechosFavoritos">@i</a>
                                            </li>
                                        }
                                    </ul>
                                </nav>
                            }
                            else
                            {
                                <li class="list-group-item">Nenhum trecho favorito adicionado.</li>
                            }
                        </ul>
                    </div>

                </div>

            </div>
            <!-- Botões -->
            <div class="d-flex justify-content-between mt-4 mb-5" style="margin-bottom: 100px" ;>
                <a asp-controller="Livro" asp-action="MeusFavoritos" asp-route-usuarioId="@usuarioId" class="btn btn-secondary w-48">Voltar</a>
            </div>

        </div>
    </div>
</div>