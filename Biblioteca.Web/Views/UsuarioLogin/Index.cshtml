@model Biblioteca.Web.Models.UsuarioModel

@{
    Layout = "_LayoutDeslogado";
    ViewData["Title"] = "Login";
}
<!-- #Erro mensagen-->
@if (TempData["Erro"] != null)
{
    <div class="alert alert-danger text-center">
        @TempData["Erro"]
    </div>
}

<div class="login-page">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-4">
                <div class="card shadow p-4">
                    <h2 class="text-center mb-4 discord-color">Bem-vindo<br>Litmap</h2>
                    <p class="text-center mb-4 text-muted">
                        A maneira mais fácil de organizar seus livros e administrar sua biblioteca pessoal.
                        Registre-se agora e tenha controle total sobre sua coleção!
                    </p>

                    <form method="post" asp-action="Login">
                        <h4 class="mb-3 discord-color">Entrar na sua conta</h4>

                        <div class="mb-3">
                            <label for="Email" class="form-label">E-mail</label>
                            <input type="email" class="form-control" id="Email" asp-for="Email"
                                placeholder="Digite seu e-mail" required>
                        </div>

                        <div class="mb-3">
                            <label for="Senha" class="form-label">Senha</label>
                            <input type="password" class="form-control" id="Senha" asp-for="SenhaHas"
                                placeholder="Digite sua senha" required>
                        </div>

                        <div class="mb-3 text-end">
                            <a asp-controller="UsuarioLogin" asp-action="SolicitarRedefiniSenha"
                                class="discord-color small">Esqueceu sua senha?</a>
                        </div>


                        <div class="mb-3 text-end">
                            <a href="#" class="discord-color small" data-bs-toggle="modal"
                                data-bs-target="#modalRegistrarUsuario">Cria nova conta</a>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">Login</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!--==================================MODAL CRIAR USUARIO=======================================-->

<div class="modal fade" id="modalRegistrarUsuario" tabindex="-1" aria-labelledby="modalRegistrarUsuarioLabel"
    aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white border-0">
            <div class="modal-header border-0">
                <h5 class="modal-title discord-color" id="modalRegistrarUsuarioLabel">Criar uma nova conta</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                    aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <form method="post" asp-action="RegistrarUsuario" id="formRegistroUsuario">
                    <p class="mb-4 text-muted">Comece sua jornada e tenha acesso total ao seu catálogo de livros.</p>

                    <div class="mb-3">
                        <label for="Nome" class="form-label">Nome</label>
                        <input type="text" class="form-control" id="Nome" name="nome" placeholder="Digite seu nome"
                            required>
                    </div>

                    <div class="mb-3">
                        <label for="EmailRegistro" class="form-label">E-mail</label>
                        <input type="email" class="form-control" id="EmailRegistro" name="email"
                            placeholder="Digite seu e-mail" required>
                    </div>

                    <div class="mb-3">
                        <label for="SenhaRegistro" class="form-label">Senha</label>
                        <input type="password" class="form-control" id="SenhaRegistro" name="senhaHas"
                            placeholder="Crie uma senha" required>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-success">Registrar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>