@model List<Biblioteca.Web.Models.LivroModel>

@{
    Layout = "_LayoutDeslogado";
    ViewData["Title"] = "Meus Favoritos";
    var usuarioId = Context.Session.GetString("UsuarioId");
}

<div class="banner text-center text-white d-flex align-items-center justify-content-center">
    <h1 class="display-3 fw-bold text-uppercase m-0">Litmap.</h1>
</div>

<div class="container mt-5 mb-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex flex-column">
            <h2 class="discord-color fw-bold text-primary mb-2">Confira meus Livros Favoritos.</h2>
            <p class="text-muted mb-0">
                Veja quais títulos estão inspirando pessoas e aproveite para montar o seu próprio catálogo de livros.
            </p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(ViewBag.Mensagem))
    {
        <div class="alert alert-info">@ViewBag.Mensagem</div>
    }

    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4">
        @if (Model != null && Model.Count > 0)
        {
            foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm">

                        @* Verifica se é um link ou imagem local *@
                        @{
                            string imagemSrc = string.IsNullOrEmpty(item.Imagem)
                            ? ""
                            : (item.Imagem.StartsWith("http") ? item.Imagem : Url.Content($"~/images/{item.Imagem}"));
                        }

                        <img src="@imagemSrc" class="card-img-top" alt="Imagem do Livro"
                             style="width: 100%; height: 250px; object-fit: contain;">
                        
                         <div class="card-body">
                            <h4 class="card-title discord-color">@item.Name</h4>
                            <p class="card-text"><strong style="color: white;">Autor:</strong> @item.Autor</p>
                            <p class="card-text"><strong style="color: white;">Gênero:</strong> @item.Genero</p>
                            <!--<p class="card-text"><strong style="color: white;">Idioma:</strong> @item.Idioma</p>-->
                            <p class="card-text"><strong style="color: white;">Ano:</strong> @item.ano</p>
                            <p class="card-text"><strong style="color: white;">Status:</strong> @(item.LivroFinalizado ?
                                                        "Finalizado" : "Em progresso")</p>

                    <!-- Avaliação com estrelas -->
                    <p class="card-text">
                        <strong style="color: white;">Avaliação:</strong>
                        @if (!string.IsNullOrEmpty(item.Avaliacao) && int.TryParse(item.Avaliacao, out int nota))
                                {
                                    @(new string('⭐', nota))
                                }
                                else
                                {
                                    <span>N/A</span>
                                }
                            </p>
                        </div>

                        <div class="card-footer d-flex justify-content-between bg-dark py-2 px-3">
                            <div class="btn-group btn-group-sm">
                                <a class="btn btn-primary btn-clean" asp-controller="Livro" asp-action="MeusFavoritosDetails"
                                   asp-route-id="@item.Id" asp-route-usuarioId="@usuarioId">Detalhes</a>
                            </div>
                           
                        </div>

                    </div>
                </div>
            }
        }
        else
        {
            <p class="text-center">Nenhum livro favorito encontrado.</p>
        }
    </div>
</div>